{
  "name": "@kovapdf/sdk",
  "version": "0.1.0",
  "description": "The official KovaPDF client for Node.js: compress, merge, split, convert, read scans, redact, check signatures and send documents for signature. Includes the kovapdf command line tool.",
  "license": "MIT",
  "homepage": "https://www.kovapdf.com/developers",
  "repository": { "type": "git", "url": "git+https://github.com/KovaPDF/kovapdf-js.git" },
  "bugs": "https://www.kovapdf.com/contact",
  "keywords": ["pdf", "kovapdf", "compress", "merge", "ocr", "redact", "e-signature", "bijoy", "unicode"],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    },
    "./package.json": "./package.json"
  },
  "bin": { "kovapdf": "dist/esm/cli.js" },
  "files": ["dist", "README.md", "LICENSE", "SECURITY.md", "CHANGELOG.md"],
  "sideEffects": false,
  "engines": { "node": ">=18.17" },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/after-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
